# Aegisx-Agent Configuration
# Copy this file to .env and fill in the values

# Scan Settings
AEGISX_SCAN_MODE=quick
AEGISX_MAX_DEPTH=3
AEGISX_MAX_REQUESTS_PER_SECOND=10.0
AEGISX_TIMEOUT_SECONDS=30

# User Agent (identify yourself or use custom)
AEGISX_USER_AGENT=AegisxAgent/0.1.0 (Security Scanner)

# Scanners to enable (comma-separated)
# Options: web_scanner, secret_scanner, config_scanner, dependency_scanner
AEGISX_ENABLED_SCANNERS=["web_scanner","secret_scanner","config_scanner","dependency_scanner"]

# Exploit Verification (requires explicit consent)
AEGISX_EXPLOIT_VERIFICATION=false

# Sandbox (run exploits in Docker container)
AEGISX_SANDBOX_ENABLED=true
AEGISX_SANDBOX_IMAGE=aegisx-sandbox:latest

# Reporting
AEGISX_REPORT_FORMAT=markdown
AEGISX_REPORT_OUTPUT=reports/

# Logging
AEGISX_LOG_LEVEL=INFO
AEGISX_VERBOSE=false

# Target Authentication (optional)
# AEGISX_AUTH_TOKEN=your-token-here
# AEGISX_AUTH_HEADER=Authorization

# Scope Whitelist (domains only, comma-separated)
# AEGISX_SCOPE=["example.com","api.example.com"]

# ─── AI Agent (AegisX Brain) ─────────────────────────────────────────────
# Works with ANY OpenAI-compatible endpoint (custom URL + key).
# Presets: custom | deepseek | openai | groq | openrouter | ollama
# AEGISX_AI_PROVIDER=custom
# AEGISX_AI_BASE_URL=https://api.deepseek.com/v1
# AEGISX_AI_API_KEY=sk-your-key-here
# AEGISX_AI_MODEL=deepseek-chat
# AEGISX_AI_MAX_ITERATIONS=25
# AEGISX_AI_MAX_TOKENS=4000
# AEGISX_AI_TEMPERATURE=0.2
